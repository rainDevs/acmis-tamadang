# Copy to .env (never commit .env). Placeholders only.
APP_ENV=development
APP_URL=http://localhost:8000

# MySQL (fill locally; keep production values out of git)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=acmis
DB_USER=
DB_PASS=

# Session cookie (TASK-013). SameSite: Lax (same-origin default) or None
# (cross-origin dev only — requires Secure). Secure=1 under HTTPS.
# Local cross-origin dev (Vite :5173 → API :8000): None + 1.
SESSION_SAMESITE=Lax
SESSION_SECURE=0

# CORS origins for browser dev (comma-separated; production host goes here)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

